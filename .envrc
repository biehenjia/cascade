# Give each devshell its own Git global config and GitHub CLI state.  Git and
# gh normally follow HOME, but that changes below; pin both paths first so a
# `gh auth login` in this project is remembered by Git in this devshell.
real_git_config="${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig}"
export GIT_CONFIG_GLOBAL="$PWD/.home/.gitconfig"
export GH_CONFIG_DIR="$PWD/.home/.config/gh"

# Codex normally follows HOME to ~/.codex. Pin its home while HOME still means
# the real user home, so config, credentials, and sessions stay shared rather
# than being recreated in every project's .home sandbox.
export CODEX_HOME="${CODEX_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/codex}"

# Per-project HOME sandbox: everything the devshell writes to "$HOME" (tool
# caches, configs, state) lands in ./.home instead of the real home directory,
# so projects can't leak into each other or into ~.
export HOME="$PWD/.home"
mkdir -p "$HOME"

# Reload the shell when the package list changes (xin add/remove also trigger
# an explicit reload, but this covers hand edits).
watch_file packages.nix

# nix-direnv (loaded from ~/.config/direnv/direnvrc) makes this cached + GC-rooted.
use flake

# Preserve ordinary Git preferences (identity, aliases, signing, etc.) from
# the real global config while making GitHub credentials deliberately local to
# this devshell.  `gh auth login` writes its token to GH_CONFIG_DIR; this
# helper lets every Git repository in the devshell retrieve it.  The helper is
# resolved from PATH, rather than baked to a Nix-store path, so it survives
# devshell rebuilds and garbage collection.  This follows `use flake` so the
# template only relies on its own Git package, not a host-installed Git.
if ! git config --global --get --bool devshell.ghCredentialHelper 2>/dev/null | grep -qx true; then
  if [ -f "$real_git_config" ]; then
    git config --global --add include.path "$real_git_config"
  fi
  for host in https://github.com https://gist.github.com; do
    git config --global --add "credential.${host}.helper" ''
    git config --global --add "credential.${host}.helper" '!gh auth git-credential'
  done
  git config --global devshell.ghCredentialHelper true
fi
